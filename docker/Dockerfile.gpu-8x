# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip uv && \
    uv venv --python 3.12 /opt/openthoughts/.venv

ENV VIRTUAL_ENV=/opt/openthoughts/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /opt/openthoughts
COPY pyproject.toml ./
COPY uv.lock ./
COPY README.md ./
COPY eval ./eval
COPY hpc ./hpc
COPY scripts ./scripts
COPY data ./data
COPY database ./database
COPY sft ./sft
COPY rl ./rl
COPY assets ./assets
COPY build_support.py ./
COPY setup.py ./
COPY CLAUDE.md ./
COPY CONTRIBUTING.md ./
COPY LICENSE.txt ./
COPY docker ./docker

ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=5
# Use the checked-in lock for the complete runtime closure.  In particular,
# agentic evals persist Harbor traces to s3:// on CoreWeave and therefore need
# the lock-pinned ``s3fs`` selected by the ``cloud`` extra.  Do not layer a
# second ``uv pip install``/Harbor reinstall over this: it would make the image
# differ from the lock consumed by the launch-time frozen sync.
RUN . /opt/openthoughts/.venv/bin/activate && \
    uv sync --frozen --no-dev --extra datagen --extra cloud --extra harbor-all
RUN echo "ulimit -n 65535" >> /etc/profile.d/openthoughts-ulimit.sh

ENV NVIDIA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

CMD ["bash"]
