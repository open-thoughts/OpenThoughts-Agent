# syntax=docker/dockerfile:1
# gpu-glm52-nvcc — the gpu-glm52 datagen image built on the CUDA *devel* base (ships nvcc +
# CUDA headers/libs), so runtime-JIT kernels (FlashInfer, DeepGEMM, Triton) can nvcc/ninja-compile
# their kernels at serve time — the alternative to Dockerfile.gpu-glm52 (runtime base, NO nvcc)
# where those kernels must be disabled in the serve config. Everything else is identical to
# Dockerfile.gpu-glm52: same datagen/harbor extras, same VLLM_USE_PRECOMPILED fork-vLLM swap
# (the devel base's nvcc is for the OTHER libs' runtime JIT, not for recompiling vLLM's own
# kernels), same GlmMoeDsaForCausalLM registry assertion.
#
# The worker runs from THIS baked /opt/openthoughts/.venv (launch tracegen with --baked-venv, which
# skips the uv-sync resync that would otherwise rebuild /app/.venv from the locked 0.16 pin).
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Fail the build loudly if the base does not ship nvcc (the whole point of the devel base).
RUN nvcc --version && test -x /usr/local/cuda/bin/nvcc && echo "nvcc OK"

RUN pip3 install --upgrade pip uv && \
    uv venv --python 3.12 /opt/openthoughts/.venv

ENV VIRTUAL_ENV=/opt/openthoughts/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /opt/openthoughts
COPY pyproject.toml ./
COPY README.md ./
COPY eval ./eval
COPY hpc ./hpc
COPY scripts ./scripts
COPY data ./data
COPY database ./database
COPY sft ./sft
COPY rl ./rl
COPY assets ./assets
COPY build_support.py ./
COPY setup.py ./
COPY CLAUDE.md ./
COPY CONTRIBUTING.md ./
COPY LICENSE.txt ./
COPY docker ./docker

ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=5
RUN . /opt/openthoughts/.venv/bin/activate && uv pip install -e ".[datagen,cloud,harbor-all]"

# --- GLM-5.2: swap the pinned pypi vLLM for the marin-community fork (main). VLLM_USE_PRECOMPILED
#     avoids recompiling vLLM's OWN kernels: setup.py fetches precompiled kernels from the pinned
#     fork<->upstream merge-base commit (cu129 abi3 wheel; runs on the 12.8 cudnn base) and installs
#     the fork-main Python. (The devel base's nvcc is separately used at serve time for the runtime
#     JIT of FlashInfer/DeepGEMM/Triton.) The explicit WHEEL_COMMIT is REQUIRED — a git-clone install
#     is detached-HEAD, so auto-detect would fall back to "nightly" (ABI risk).
ENV VLLM_USE_PRECOMPILED=1 \
    VLLM_PRECOMPILED_WHEEL_COMMIT=a30addc7548a9a8b9b3323a7bc3eb7d7c4895d1c \
    VLLM_MAIN_CUDA_VERSION=12.9
RUN . /opt/openthoughts/.venv/bin/activate && \
    uv pip install "vllm @ git+https://github.com/marin-community/vllm@main" && \
    python -c "import vllm; from vllm.model_executor.models.registry import ModelRegistry as R; \
print('vllm', vllm.__version__); \
assert 'GlmMoeDsaForCausalLM' in R.get_supported_archs(), 'GlmMoeDsaForCausalLM MISSING from vllm registry'; \
print('GlmMoeDsaForCausalLM OK')"

# GLM jobs use --baked-venv, so pin Harbor from source here as well as in the
# TPU runtime lock. Changing this value intentionally invalidates Kaniko's
# cached Harbor layer for every relaunch image.
ENV HARBOR_COMMIT=772e20f7a76bec749e634a054ff4546a3468f5cb
RUN . /opt/openthoughts/.venv/bin/activate && \
    uv pip install --force-reinstall --no-deps \
      "harbor[daytona] @ git+https://github.com/marin-community/harbor.git@${HARBOR_COMMIT}" && \
    python -c "import harbor; from harbor import _route_s3_endpoint_url_to_client_kwargs; \
print('harbor', harbor.__version__, '- s3 endpoint_url routing present')"

RUN echo "ulimit -n 65535" >> /etc/profile.d/openthoughts-ulimit.sh

ENV NVIDIA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

CMD ["bash"]
